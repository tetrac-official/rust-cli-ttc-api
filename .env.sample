# =============================================================================
# TTC Trading CLI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Run `skill-trading login` to auto-populate TTC_AUTH_TOKEN and TTC_PUBLIC_KEY.
# =============================================================================

# TTC Box Session Credentials
# Populated automatically by: skill-trading login / skill-trading register
TTC_AUTH_TOKEN=
TTC_PUBLIC_KEY=
TTC_EXCHANGE=asterdex

# =============================================================================
# Exchange API Keys
# Format: {EXCHANGE}_API_KEY / {EXCHANGE}_API_SECRET / {EXCHANGE}_API_PASSPHRASE
# Passphrase required for: OKX, KuCoin, Orderly, Bitget, BloFin
# =============================================================================

ASTERDEX_API_KEY=
ASTERDEX_API_SECRET=

BINANCE_API_KEY=
BINANCE_API_SECRET=

BYBIT_API_KEY=
BYBIT_API_SECRET=

PHEMEX_API_KEY=
